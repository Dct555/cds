{
  "name": "@coinbase/cds-illustrations",
  "version": "4.49.0",
  "description": "CDS illustrations",
  "repository": {
    "type": "git",
    "url": "git@github.com:coinbase/cds.git",
    "directory": "packages/illustrations"
  },
  "type": "module",
  "main": "./esm/index.js",
  "types": "./dts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dts/index.d.ts",
      "default": "./esm/index.js"
    },
    "./*": {
      "types": "./dts/*.d.ts",
      "default": "./esm/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dts",
    "esm",
    "CHANGELOG"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.27.1",
    "@cds/figma-api": "workspace:^",
    "@figma/rest-api-spec": "^0.34.0",
    "@types/lodash": "^4.14.178",
    "lodash": "^4.17.21",
    "sharp": "^0.35.5",
    "svgo": "^3.3.5"
  }
}
